{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "azwad-three.vercel.app" }],
      "destination": "https://nadidazwad.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/work/:project/case-study.md", "destination": "/share/:project.html" },
    {
      "source": "/((?!media/|sound/|fonts/|assets/|icons/|og/|share/|favicon|apple-touch-icon|site.webmanifest|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(media|sound|og|icons)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
